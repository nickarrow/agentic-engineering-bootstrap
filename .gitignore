# This is the kit's own ignore file, for this repository's hygiene. It is not
# the one that travels. The one that travels is starter/.gitignore, and it has
# to be copied into an adopting project by hand, because a nested ignore file
# does not apply to a parent directory.

# Working material that lives beside this repository and must never be
# committed into it. The real protection is that it sits outside this directory
# entirely. These patterns are the second line, and they are deliberately
# generic, because naming the specific files here would publish their names.
docs/
drafts/
research/
*-transcript.md
*-internal.md
*-confidential.md
*-draft.md
*-v[0-9].md

# Anything that looks like real data has no business at this level at all.
*.csv
*.xlsx
*.xls
data/
extracts/
phi/
pii/

# The fixture lives under starter/ and is governed by starter/.gitignore, which
# re-includes it. Listed here too so that the rule above cannot swallow it if
# anybody flattens the layout later.
!starter/sensitive/FAKE-*.csv

# Agent scratch and worktrees, never committed.
.agents/
.worktrees/

# Local environment
.env
.env.*
.DS_Store
node_modules/
